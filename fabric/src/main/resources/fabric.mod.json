{
  "schemaVersion": 1,
  "id": "native-threading",
  "version": "${version}",
  "name": "Native Threading",
  "description": "Parallel explosion computation for Minecraft servers. Use /parallel to control.",
  "authors": [
    "uright008"
  ],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.github.uright008.nt.NativeThreading"
    ]
  },
  "mixins": [
    "parallel-core.mixins.json",
    "explosion.mixins.json"
  ],
  "provides": [
    "parallel-core",
    "explosion"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}