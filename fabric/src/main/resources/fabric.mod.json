{
  "schemaVersion": 1,
  "id": "native-threading",
  "version": "${version}",
  "name": "Native Threading",
  "description": "Native threading explosion computation for Minecraft servers, including a client's integrated (single-player) server. Use /nt to control.",
  "authors": [
    "uright008"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.uright008.nt.NativeThreading"
    ]
  },
  "mixins": [
    "core.mixins.json",
    "explosion.mixins.json"
  ],
  "provides": [
    "native-threading-core",
    "explosion"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}